<Application x:Class="Killendar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] is the live palette: ThemeManager replaces THIS dictionary at startup and
                     on every theme change with the finished palette (accent overlay included), so
                     it must stay first and must be the only palette here. Dark is Killendar's
                     shipped default; the red accent comes from AppTheme.Configure (SetDefaults).
                     It is Dark's red (#DD504B) that the wordmark, the og-image and killendar.net
                     are built on, not Black's #FF2929. -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <!-- The family control styles from the KillerUI template, identical in every app. -->
                <ResourceDictionary Source="Controls/Controls.xaml"/>
                <!-- Killendar's own control styles, the ones no other family app uses. -->
                <ResourceDictionary Source="Controls/AppStyles.xaml"/>
                <!-- English string base, ALWAYS present. LocaleManager finds it by its source,
                     re-asserts it and layers the chosen locale directly after it, so a partial
                     translation falls back to English instead of rendering raw Str_ key names. -->
                <ResourceDictionary Source="Strings/en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
