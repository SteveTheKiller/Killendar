    <sys:String x:Key="Str_Status_PwMismatch">Die beiden Kennwörter stimmen nicht überein</sys:String>
    <sys:String x:Key="Str_Status_PwFailed">Kennwort konnte nicht geändert werden: {0}</sys:String>
    <sys:String x:Key="Str_Status_FreshKcal">Neuer Killendar angelegt; der gesperrte wurde als {0} behalten</sys:String>


    <!-- Export warning: an .ics is plain text, so exporting from an encrypted
         Killendar hands out what the password was protecting. -->
    <sys:String x:Key="Str_Exp_WarnHead">Aus einem verschlüsselten Killendar exportieren?</sys:String>
    <sys:String x:Key="Str_Exp_WarnBody">Eine .ics-Datei ist unverschlüsselter Text. Alles, was Sie exportieren, kann jeder lesen, der die Datei öffnet, und das Kennwort dieses Killendars schützt es nicht mehr.</sys:String>
    <sys:String x:Key="Str_Exp_WarnCheck">Nicht mehr daran erinnern</sys:String>


