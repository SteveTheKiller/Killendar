<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- English base. Always merged; every other locale layers on top, so a key missing from a
         translation falls back to English rather than showing the raw key name. -->

    <!-- Toolbar -->
    <sys:String x:Key="Str_Btn_New">+ New</sys:String>
    <sys:String x:Key="Str_Btn_Import">Import .ics</sys:String>
    <sys:String x:Key="Str_Btn_Export">Export .ics</sys:String>
    <sys:String x:Key="Str_Btn_Today">Today</sys:String>
    <sys:String x:Key="Str_View_Month">Month</sys:String>
    <sys:String x:Key="Str_View_Week">Week</sys:String>
    <sys:String x:Key="Str_View_Day">Day</sys:String>
    <sys:String x:Key="Str_View_Agenda">Agenda</sys:String>
    <sys:String x:Key="Str_TT_Prev">Previous</sys:String>
    <sys:String x:Key="Str_TT_Next">Next</sys:String>

    <!-- Rail -->
    <sys:String x:Key="Str_TT_Theme">Theme</sys:String>
    <sys:String x:Key="Str_TT_Language">Language</sys:String>
    <sys:String x:Key="Str_TT_PanelShow">Show appointment panel</sys:String>
    <sys:String x:Key="Str_TT_PanelHide">Hide appointment panel</sys:String>
    <sys:String x:Key="Str_Lbl_Theme">theme</sys:String>
    <sys:String x:Key="Str_Lbl_Accent">accent</sys:String>

    <!-- Appointment sidebar -->
    <sys:String x:Key="Str_Side_New">New appointment</sys:String>
    <sys:String x:Key="Str_Side_Edit">Edit appointment</sys:String>
    <sys:String x:Key="Str_Fld_Title">TITLE</sys:String>
    <sys:String x:Key="Str_Fld_Starts">STARTS</sys:String>
    <sys:String x:Key="Str_Fld_Ends">ENDS</sys:String>
    <sys:String x:Key="Str_Fld_Location">LOCATION</sys:String>
    <sys:String x:Key="Str_Fld_Description">DESCRIPTION</sys:String>
    <sys:String x:Key="Str_Fld_Attendees">ATTENDEES</sys:String>
    <sys:String x:Key="Str_Hint_Attendees">comma separated</sys:String>
    <sys:String x:Key="Str_Hint_Date">yyyy-mm-dd</sys:String>
    <sys:String x:Key="Str_Hint_Time">h:mm am/pm or 24h</sys:String>
    <sys:String x:Key="Str_Hint_AttendeesTip">Comma separated email addresses</sys:String>
    <sys:String x:Key="Str_Chk_AllDayOff">[ ] all day</sys:String>
    <sys:String x:Key="Str_Chk_AllDayOn">[x] all day</sys:String>
    <sys:String x:Key="Str_Btn_Save">Save</sys:String>
    <sys:String x:Key="Str_Btn_Cancel">Cancel</sys:String>
    <sys:String x:Key="Str_Btn_Delete">Delete</sys:String>

    <!-- Validation -->
    <sys:String x:Key="Str_Err_NoTitle">Give it a title.</sys:String>
    <sys:String x:Key="Str_Err_StartDate">Start date should look like 2026-07-29.</sys:String>
    <sys:String x:Key="Str_Err_EndDate">End date should look like 2026-07-29.</sys:String>
    <sys:String x:Key="Str_Err_StartTime">Start time should look like 9:30 am or 21:30.</sys:String>
    <sys:String x:Key="Str_Err_EndTime">End time should look like 9:30 am or 21:30.</sys:String>
    <sys:String x:Key="Str_Err_EndBeforeStart">It has to end after it starts.</sys:String>

    <!-- Delete confirmation. {0} is the appointment title. -->
    <sys:String x:Key="Str_Dlg_DeleteMsg">Delete "{0}"?</sys:String>
    <sys:String x:Key="Str_Dlg_DeleteDetail">This cannot be undone.</sys:String>

    <!-- Status line. {0} is a title or a count. -->
    <sys:String x:Key="Str_Status_Ready">Ready</sys:String>
    <sys:String x:Key="Str_Status_Added">Added {0}</sys:String>
    <sys:String x:Key="Str_Status_Saved">Saved {0}</sys:String>
    <sys:String x:Key="Str_Status_Deleted">Deleted {0}</sys:String>
    <sys:String x:Key="Str_Status_Imported">Imported {0} appointments</sys:String>
    <sys:String x:Key="Str_Status_ImportedSkipped">Imported {0} appointments, skipped {1} already present</sys:String>
    <sys:String x:Key="Str_Status_ImportFailed">Import failed: {0}</sys:String>
    <sys:String x:Key="Str_Status_Exported">Exported {0} appointments</sys:String>
    <sys:String x:Key="Str_Status_ExportFailed">Export failed: {0}</sys:String>
    <sys:String x:Key="Str_Status_NothingToExport">Nothing to export</sys:String>
    <sys:String x:Key="Str_Status_LoadError">Could not open this Killendar: {0}</sys:String>
    <sys:String x:Key="Str_Status_Migrated">Migrated {0} appointments into your Killendar</sys:String>

    <!-- File dialogs -->
    <sys:String x:Key="Str_Dlg_ImportTitle">Import iCalendar</sys:String>
    <sys:String x:Key="Str_Dlg_ExportTitle">Export iCalendar</sys:String>
    <sys:String x:Key="Str_Dlg_IcsFilter">iCalendar files (*.ics)|*.ics|All files (*.*)|*.*</sys:String>
    <sys:String x:Key="Str_Dlg_IcsSaveFilter">iCalendar files (*.ics)|*.ics</sys:String>

    <!-- Views -->
    <sys:String x:Key="Str_Cal_AllDay">all day</sys:String>
    <sys:String x:Key="Str_Cal_NoTitle">(no title)</sys:String>
    <sys:String x:Key="Str_Cal_Today">TODAY</sys:String>
    <sys:String x:Key="Str_Cal_MoreCount">+{0} more</sys:String>
    <sys:String x:Key="Str_Cal_AgendaEmpty">Nothing scheduled in this window.</sys:String>
    <sys:String x:Key="Str_TT_NewOnDay">New appointment on this day</sys:String>

    <!-- About card -->
    <sys:String x:Key="Str_About_Version">VERSION</sys:String>
    <sys:String x:Key="Str_About_Publisher">PUBLISHER</sys:String>
    <sys:String x:Key="Str_About_Thumbprint">THUMBPRINT</sys:String>
    <sys:String x:Key="Str_About_Sha">EXE SHA-256</sys:String>
    <sys:String x:Key="Str_About_Computing">computing...</sys:String>
    <sys:String x:Key="Str_About_Unsigned">(not signed or chain failed)</sys:String>
    <sys:String x:Key="Str_About_UpdateAvailable">Update available: {0}</sys:String>
    <sys:String x:Key="Str_About_Downloading">Downloading...</sys:String>
    <!-- Tagline is split so the GPLv3 licence and the Killer Tools link stay untranslated. -->
    <sys:String x:Key="Str_About_DescA" xml:space="preserve">Month, week, day and agenda views, iCalendar import and export, and appointments that never leave your machine. A GPLv3 </sys:String>
    <sys:String x:Key="Str_About_DescB" xml:space="preserve"> utility.</sys:String>

    <!-- Self-update prompt -->
    <sys:String x:Key="Str_Dlg_UpdateMsg">Download and install Killendar {0}?</sys:String>
    <sys:String x:Key="Str_Dlg_UpdateBullets">The app will close and reopen automatically.</sys:String>
    <sys:String x:Key="Str_Btn_Update">Update</sys:String>

    <!-- Keyboard shortcuts overlay -->
    <sys:String x:Key="Str_Sc_Title">Keyboard shortcuts</sys:String>
    <sys:String x:Key="Str_Sc_New">New appointment</sys:String>
    <sys:String x:Key="Str_Sc_Today">Jump to today</sys:String>
    <sys:String x:Key="Str_Sc_Prev">Previous period</sys:String>
    <sys:String x:Key="Str_Sc_Next">Next period</sys:String>
    <sys:String x:Key="Str_Sc_Month">Month view</sys:String>
    <sys:String x:Key="Str_Sc_Week">Week view</sys:String>
    <sys:String x:Key="Str_Sc_Day">Day view</sys:String>
    <sys:String x:Key="Str_Sc_Agenda">Agenda view</sys:String>
    <sys:String x:Key="Str_Sc_Panel">Show or hide the appointment panel</sys:String>
    <sys:String x:Key="Str_Sc_About">About</sys:String>
    <sys:String x:Key="Str_Sc_Close">Close the panel or overlay</sys:String>
    <sys:String x:Key="Str_Sc_Hint">Single keys work whenever you are not typing in a field.</sys:String>

    <!-- Date format picker (in the language menu). The three samples are format examples,
         so they read the same in every language. -->
    <sys:String x:Key="Str_Lbl_DateFormat">date format</sys:String>
    <sys:String x:Key="Str_Date_FollowWindows">Follow Windows</sys:String>
    <sys:String x:Key="Str_Date_Iso">ISO (2026-07-29)</sys:String>
    <sys:String x:Key="Str_Date_US">US (7/29/2026)</sys:String>
    <sys:String x:Key="Str_Date_EU">UK / EU (29/07/2026)</sys:String>


    <!-- Encryption: unlock prompt, the title-bar lock button (set/change/remove),
         and the forgotten-password escape hatch. {0} is a file name or an error. -->
    <sys:String x:Key="Str_Pw_UnlockHead">Unlock this Killendar</sys:String>
    <sys:String x:Key="Str_Pw_WrongPw">That password did not work. Try again.</sys:String>
    <sys:String x:Key="Str_Pw_Protected">{0} is encrypted. Enter its password to open it.</sys:String>
    <sys:String x:Key="Str_Pw_NewKcalBtn">New Killendar...</sys:String>
    <sys:String x:Key="Str_Pw_SetHead">Encrypt this Killendar</sys:String>
    <sys:String x:Key="Str_Pw_SetBody">Your appointments will be encrypted at rest with AES-256. You will be asked for this password every time Killendar starts.</sys:String>
    <sys:String x:Key="Str_Pw_ChangeHead">Change or remove the password</sys:String>
    <sys:String x:Key="Str_Pw_ChangeBody">Enter a new password, or leave both boxes empty to remove encryption and store this Killendar as plain SQLite.</sys:String>
    <sys:String x:Key="Str_Pw_ConfirmLbl">CONFIRM</sys:String>
    <sys:String x:Key="Str_Pw_NoRecovery">There is no recovery. Lose the password and the appointments in this Killendar are gone for good.</sys:String>
    <sys:String x:Key="Str_Btn_Unlock">Unlock</sys:String>
    <sys:String x:Key="Str_Btn_Encrypt">Encrypt</sys:String>
    <sys:String x:Key="Str_Btn_Apply">Apply</sys:String>
    <sys:String x:Key="Str_Btn_StartNew">Start new</sys:String>
    <sys:String x:Key="Str_Dlg_FreshHead">Start a new Killendar?</sys:String>
    <sys:String x:Key="Str_Dlg_FreshBody">The locked Killendar is renamed and kept on disk, but without its password the appointments inside cannot be read. A new empty Killendar opens in its place.</sys:String>
    <sys:String x:Key="Str_Tip_LockOn">Encrypted - click to change or remove the password</sys:String>
    <sys:String x:Key="Str_Tip_LockOff">Not encrypted - click to set a password</sys:String>
    <sys:String x:Key="Str_Status_Encrypted">This Killendar is now encrypted</sys:String>
    <sys:String x:Key="Str_Status_PwChanged">Password changed</sys:String>
    <sys:String x:Key="Str_Status_PwRemoved">Password removed - this Killendar is no longer encrypted</sys:String>
    <sys:String x:Key="Str_Status_PwMismatch">The two passwords do not match</sys:String>
    <sys:String x:Key="Str_Status_PwFailed">Could not change the password: {0}</sys:String>
    <sys:String x:Key="Str_Status_FreshKcal">New Killendar started; the locked one was kept as {0}</sys:String>

    <!-- Exporting an encrypted Killendar to .ics writes plain text, which quietly undoes the
         encryption for whatever leaves the app. Warned once, then suppressible. -->
    <sys:String x:Key="Str_Exp_WarnHead">Export from an encrypted Killendar?</sys:String>
    <sys:String x:Key="Str_Exp_WarnBody">An .ics file is plain text. Everything you export can be read by anyone who opens it, and this Killendar's password no longer protects it.</sys:String>
    <sys:String x:Key="Str_Exp_WarnCheck">Don't remind me again</sys:String>


    <!-- Manage Killendars: the .kcal file list, its context menu and the rail
         button. {0} is a file name or an error; Str_Kc_Renamed takes {0} old, {1} new. -->
    <sys:String x:Key="Str_Kc_Title">Killendars</sys:String>
    <sys:String x:Key="Str_Kc_Hint">Every .kcal in your data folder. Double-click a name to rename it.</sys:String>
    <sys:String x:Key="Str_Kc_FlagEncrypted">encrypted</sys:String>
    <sys:String x:Key="Str_Kc_FlagActive">open</sys:String>
    <sys:String x:Key="Str_Kc_SelectFirst">Select a Killendar first.</sys:String>
    <sys:String x:Key="Str_Kc_BadName">That name has characters a file name cannot contain.</sys:String>
    <sys:String x:Key="Str_Kc_Exists">{0} already exists.</sys:String>
    <sys:String x:Key="Str_Kc_Renamed">Renamed {0} to {1}</sys:String>
    <sys:String x:Key="Str_Kc_RenameFailed">Rename failed: {0}</sys:String>
    <sys:String x:Key="Str_Kc_CreateFailed">Could not create a Killendar: {0}</sys:String>
    <sys:String x:Key="Str_Kc_DeleteHead">Delete {0}?</sys:String>
    <sys:String x:Key="Str_Kc_DeleteBody">The file and every appointment in it are deleted from disk. This cannot be undone.</sys:String>
    <sys:String x:Key="Str_Kc_Deleted">Deleted {0}</sys:String>
    <sys:String x:Key="Str_Kc_DeleteFailed">Delete failed: {0}</sys:String>
    <sys:String x:Key="Str_Kc_LoadTitle">Load a Killendar</sys:String>
    <sys:String x:Key="Str_Kc_Filter">Killendar files (*.kcal)|*.kcal|All files (*.*)|*.*</sys:String>
    <sys:String x:Key="Str_Kc_Loaded">Loaded a copy as {0}</sys:String>
    <sys:String x:Key="Str_Kc_LoadFailed">Load failed: {0}</sys:String>
    <sys:String x:Key="Str_Kc_Copied">{0} is on the clipboard - paste it anywhere that takes a file</sys:String>
    <sys:String x:Key="Str_Kc_CopyFailed">Copy failed: {0}</sys:String>
    <sys:String x:Key="Str_Ctx_Rename">Rename</sys:String>
    <sys:String x:Key="Str_Ctx_Delete">Delete</sys:String>
    <sys:String x:Key="Str_Ctx_CopyFile">Copy file</sys:String>
    <sys:String x:Key="Str_Ctx_Reveal">Show in Explorer</sys:String>
    <sys:String x:Key="Str_TT_CopyFile">Put the file on the clipboard, ready to paste into Explorer or an email</sys:String>
    <sys:String x:Key="Str_TT_NewKcal">New Killendar</sys:String>
    <sys:String x:Key="Str_TT_DeleteKcal">Delete the selected Killendar</sys:String>
    <sys:String x:Key="Str_TT_LoadKcal">Load a Killendar from a file</sys:String>
    <sys:String x:Key="Str_TT_Explorer">Open the data folder</sys:String>
    <sys:String x:Key="Str_TT_Killendars">Killendars</sys:String>
    <sys:String x:Key="Str_Btn_Open">Open</sys:String>
    <sys:String x:Key="Str_Status_Opened">Opened {0}</sys:String>


    <!-- Double-clicked .kcal: the confirm before a copy is added and opened.
         {0} is the file name. -->
    <sys:String x:Key="Str_Kc_AddHead">Open {0} in Killendar?</sys:String>
    <sys:String x:Key="Str_Kc_AddBody">A copy is added to your data folder and opened. The file you double-clicked is left where it is, untouched - a Killendar is written to constantly, and that is not something to do to a file on a network share or in Downloads.</sys:String>
    <sys:String x:Key="Str_Btn_Add">Add</sys:String>


    <!-- Text-input context menu (replaces WPF's built-in Cut/Copy/Paste, which
         ignores app-level menu styling). -->
    <sys:String x:Key="Str_Ctx_Cut">Cut</sys:String>
    <sys:String x:Key="Str_Ctx_Copy">Copy</sys:String>
    <sys:String x:Key="Str_Ctx_Paste">Paste</sys:String>
    <sys:String x:Key="Str_Ctx_SelectAll">Select all</sys:String>


    <!-- Themed file dialog (FileDialog.xaml), replacing the Win32 open/save boxes.
         Str_Sum_Counts takes {0} folders, {1} files. -->
    <sys:String x:Key="Str_Btn_Replace">Replace</sys:String>
    <sys:String x:Key="Str_Dlg_FileName">File name:</sys:String>
    <sys:String x:Key="Str_Dlg_FileType">File type:</sys:String>
    <sys:String x:Key="Str_Dlg_AllFiles">All files</sys:String>
    <sys:String x:Key="Str_Dlg_NoMatchingFiles">Nothing here matches the current file type.</sys:String>
    <sys:String x:Key="Str_Dlg_NoSuchFolder">That folder does not exist.</sys:String>
    <sys:String x:Key="Str_Dlg_NoSuchFile">That file does not exist.</sys:String>
    <sys:String x:Key="Str_Dlg_OverwriteMsg">Replace {0}?</sys:String>
    <sys:String x:Key="Str_Sum_Counts">{0} folder(s), {1} file(s)</sys:String>
    <sys:String x:Key="Str_QA_Home">Home</sys:String>
    <sys:String x:Key="Str_QA_Desktop">Desktop</sys:String>
    <sys:String x:Key="Str_QA_Documents">Documents</sys:String>
    <sys:String x:Key="Str_QA_Downloads">Downloads</sys:String>
    <sys:String x:Key="Str_QA_Pictures">Pictures</sys:String>
    <sys:String x:Key="Str_Col_Name">name</sys:String>
    <sys:String x:Key="Str_Col_Size">size</sys:String>
    <sys:String x:Key="Str_Col_Modified">modified</sys:String>
    <sys:String x:Key="Str_TT_Up">Up one folder</sys:String>
    <sys:String x:Key="Str_TT_ViewList">List view</sys:String>
    <sys:String x:Key="Str_TT_ViewIcons">Icon view</sys:String>
    <sys:String x:Key="Str_TT_ViewDetails">Details view</sys:String>

</ResourceDictionary>
