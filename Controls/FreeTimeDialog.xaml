<!-- Find open time (O): gaps of at least the chosen length across the shown calendars. Clicking
     a gap closes with Chosen set, and the shell opens a new appointment there. Same chrome as
     SearchDialog; the chips and rows are built in code. -->
<Window x:Class="Killendar.Controls.FreeTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:icons="clr-namespace:Killendar.Controls"
        xmlns:kui="clr-namespace:Killendar.Controls"
        Title="Killendar"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!-- Card and caption are the shared DialogCard style and DialogTitleBar control
         (Controls.xaml, DialogTitleBar.xaml), never inline copies. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <kui:DialogTitleBar Grid.Row="0" CloseRequested="Close_Click"/>

                <StackPanel Grid.Row="1" Margin="12,8,12,12">
                    <TextBlock Text="{DynamicResource Str_Free_Length}" FontSize="11"
                               Foreground="{DynamicResource DimTextBrush}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="LengthRow" Orientation="Horizontal" Margin="0,0,0,10"/>
                    <TextBlock Text="{DynamicResource Str_Free_Range}" FontSize="11"
                               Foreground="{DynamicResource DimTextBrush}" Margin="0,0,0,4"/>
                    <StackPanel x:Name="RangeRow" Orientation="Horizontal" Margin="0,0,0,10"/>
                    <CheckBox x:Name="WorkHoursBox" Content="{DynamicResource Str_Free_WorkHours}" IsChecked="True"
                              Style="{StaticResource ThemeCheck}" Margin="0,0,0,10"
                              Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <ListBox x:Name="Results" MaxHeight="320" MinHeight="40" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.Name="{DynamicResource Str_Free_Results}"
                             MouseDoubleClick="Results_MouseDoubleClick" PreviewKeyDown="Results_PreviewKeyDown"
                             PreviewMouseLeftButtonUp="Results_MouseUp"/>
                    <TextBlock x:Name="EmptyText" Text="{DynamicResource Str_Free_None}" FontSize="11"
                               Foreground="{DynamicResource DimTextBrush}" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
    </ContentControl>
</Window>
