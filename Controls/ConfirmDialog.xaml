<!-- Themed confirm dialog: same surface, grain, shadow and wordmark language as the
     main window. Used anywhere a MessageBox would break the look - install prompts,
     the self-update prompt, destructive confirms. -->
<Window x:Class="Killendar.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Killendar"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!-- Margin is a transparent halo so the drop shadow has room to render (AllowsTransparency window,
         so WPF draws the shadow rather than the OS). -->
    <!-- Dialog cards sit on the dark tier. Inputs and DimTextBrush are calibrated against it;
         on SurfaceBrush a field is the same color as the card behind it. -->
    <Border x:Name="RootBorder" Opacity="0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="{DynamicResource AboutShadowOpacity}"/>
        </Border.Effect>
        <Grid>
            <!-- Film grain over the whole dialog (behind content), so it reads as one continuous
                 surface like the main window chrome. -->
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar: transparent so the dialog grain + surface show through and the bar blends
                     into the window instead of reading as a separate strip. Carries the app wordmark
                     (Killer in text color, second word bold in the accent) like the main title bar. -->
                <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}"
                        Height="{DynamicResource DialogTitleBarHeight}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <!-- Wordmark with the same soft dark shadow copy the main title bar uses. -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="{DynamicResource DialogTitleTextMargin}"
                              Visibility="{DynamicResource WordmarkVisibility}">
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource IconShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="The " Foreground="#D8000000"/><Run Text="Killendar" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="The " Foreground="{DynamicResource TextBrush}"/><Run Text="Killendar" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                        </Grid>
                        <TextBlock Text="Killendar" Visibility="{DynamicResource PlainTitleVisibility}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="{DynamicResource DialogTitleTextMargin}"
                                   FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource ChromeTextBrush}"/>
                        <Button Content="&#xE8BB;" Click="Cancel_Click" Style="{StaticResource ChromeCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="{DynamicResource DialogCaptionCloseMargin}"/>
                    </Grid>
                </Border>

                <!-- Body (defaults are placeholders; the configurable ctor overwrites them) -->
                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText" Text="Install Killendar to your user profile?"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="20" TextWrapping="Wrap">
                        <Run Text="- Start Menu shortcut"/>
                        <LineBreak/>
                        <Run Text="- Appears in Add/Remove Programs"/>
                    </TextBlock>
                    <!-- Up to two optional checkboxes, for a confirm that also carries a choice.
                         The box fill is the CheckBox style's default, which reads as raised
                         against this card. -->
                    <CheckBox x:Name="Check1" Visibility="Collapsed" Margin="0,14,0,0"/>
                    <CheckBox x:Name="Check2" Visibility="Collapsed" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}"
                            Width="80" Margin="0,0,8,0"/>
                    <!-- OutlineButton, NOT PrimaryButton: the confirm button is an accent outline at
                         rest that fills solid on hover, matching PasswordDialog and
                         KillendarsDialog. PrimaryButton is already solid, so hovering it only shifts
                         one shade and the button reads as dead. MinWidth rather than Width:
                         "Hinzufügen" does not fit in 80. -->
                    <Button x:Name="OkButton" Content="Install" Click="OK_Click"
                            Style="{StaticResource OutlineButton}"
                            MinWidth="80"/>
                </StackPanel>
            </Grid>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
        </Grid>
    </Border>
</Window>
