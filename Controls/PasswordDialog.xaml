<!-- Themed password prompt: same surface, grain, shadow and wordmark language as ConfirmDialog.
     One box to unlock; a second confirm box appears for set/change (the showConfirm ctor arg). -->
<Window x:Class="Killendar.Controls.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:input="clr-namespace:KillerFamily.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Killendar.Controls"
        xmlns:kui="clr-namespace:Killendar.Controls"
        Title="Killendar"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Mirrors Controls.xaml's DarkTextBox. Local rather than shared: this dialog is the only
             place in the app with a PasswordBox. -->
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <!-- Same reason as DarkTextBox: WPF's built-in Cut/Copy/Paste menu is built from the
                 framework theme and ignores this app's ContextMenu/MenuItem styles. -->
            <Setter Property="ContextMenu" Value="{DynamicResource TextInputContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid x:Name="InputRoot" Tag="{DynamicResource UseDialogCaption}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                            <input:InputContentHost x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                            <Border x:Name="inputWellOuterDark" Panel.ZIndex="2" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                            <Border x:Name="inputWellOuterLight" Panel.ZIndex="2" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                            <Border x:Name="inputWellInnerDark" Panel.ZIndex="2" IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                    BorderBrush="{DynamicResource FrameOuterDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                            <Border x:Name="inputWellInnerLight" Panel.ZIndex="2" IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                    BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="BorderThickness" Value="0">
                                <Setter TargetName="inputWellOuterDark" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="inputWellOuterLight" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="inputWellInnerDark" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="inputWellInnerLight" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, ElementName=InputRoot}" Value="True"/>
                                    <Condition Binding="{Binding AcceptsReturn, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="InputRoot" Property="MinHeight" Value="{DynamicResource CompactInputMinHeight}"/>
                                <Setter TargetName="PART_ContentHost" Property="Margin" Value="0"/>
                                <Setter TargetName="PART_ContentHost" Property="CompactPadding" Value="{DynamicResource CompactInputPadding}"/>
                                <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Center"/>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin is a transparent halo so the drop shadow has room to render. -->
    <!-- Dialog cards sit on the dark tier. Inputs and DimTextBrush are calibrated against it;
         on SurfaceBrush a field is the same color as the card behind it. -->
    <kui:PickerBorder x:Name="RootBorder" Opacity="0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <kui:PickerBorder.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="{DynamicResource AboutShadowOpacity}"/>
        </kui:PickerBorder.Effect>
        <Grid>
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}"
                        Height="{DynamicResource DialogTitleBarHeight}"
                        CornerRadius="{DynamicResource DialogTitleCornerRadius}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource DialogTitleCornerRadius}"
                                Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="{DynamicResource DialogTitleMargin}">
                        <!-- The app icon leads the caption, as it does in the main title bar. -->
                        <icons:AppIcon IsHitTestVisible="False" Source="pack://application:,,,/Resources/kd-icon.ico"
                               Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                               Margin="{DynamicResource TitleIconMargin}" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Grid VerticalAlignment="Center" Visibility="{DynamicResource WordmarkVisibility}" Margin="0,-18,0,-22">
                            <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource WordmarkShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="The " Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Killendar" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}" Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="The " Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Killendar" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="The " Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Killendar" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                        </Grid>
                        <TextBlock Text="Killendar" Visibility="{DynamicResource PlainTitleVisibility}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource ChromeTextBrush}"/>
                        </StackPanel>
                        <!-- Same X as the About card: the family overlay glyph on a card, the classic caption button on 98SE. -->
                        <Button Content="&#xE8BB;" Click="Cancel_Click" Style="{StaticResource ChromeCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="{DynamicResource DialogCaptionCloseMargin}" Visibility="{DynamicResource PlainTitleVisibility}"/>
                        <Button Content="&#x2715;" Click="Cancel_Click" Style="{StaticResource OverlayCloseButton}"
                                ToolTip="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="26" Margin="0,0,3,0"
                                Visibility="{DynamicResource AboutModernCloseVisibility}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <PasswordBox x:Name="PwBox" Style="{StaticResource DarkPasswordBox}"
                                 KeyDown="PwBox_KeyDown"/>
                    <TextBlock x:Name="ConfirmLabel" Text="{DynamicResource Str_Pw_ConfirmLbl}"
                               Foreground="{DynamicResource DimTextBrush}"
                               FontFamily="{DynamicResource UiFont}" FontSize="10"
                               Margin="0,8,0,2" Visibility="Collapsed"/>
                    <PasswordBox x:Name="PwConfirmBox" Style="{StaticResource DarkPasswordBox}"
                                 KeyDown="PwBox_KeyDown" Visibility="Collapsed"/>
                    <TextBlock x:Name="HintText" Text="{DynamicResource Str_Pw_NoRecovery}"
                               Foreground="{DynamicResource DimTextBrush}"
                               FontSize="11" LineHeight="16" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ExtraButton (left) is the unlock prompt's escape hatch: shown only when the
                     caller passes extraText ("New Killendar..."). -->
                <Grid Grid.Row="2" Margin="24,0,24,20">
                    <Button x:Name="ExtraButton" Click="Extra_Click" Visibility="Collapsed"
                            Style="{StaticResource SurfaceButton}" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}"
                                Click="Cancel_Click" Style="{StaticResource SurfaceButton}"
                                Width="80" Margin="0,0,8,0"/>
                        <Button x:Name="OkButton" Click="OK_Click"
                                Style="{StaticResource OutlineButton}" MinWidth="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
        </Grid>
    </kui:PickerBorder>
</Window>
