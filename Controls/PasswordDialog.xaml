<!-- Themed password prompt: same surface, grain, shadow and wordmark language as ConfirmDialog.
     One box to unlock; a second confirm box appears for set/change (the showConfirm ctor arg).
     Ported from KillerNotes and restyled onto Killendar's DarkTextBox look. -->
<Window x:Class="Killendar.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Killendar"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Mirrors Controls.xaml's DarkTextBox. A local copy rather than a kit addition:
             Controls.xaml is the shared KillerUI file and is kept byte-identical across the
             family, so a PasswordBox style belongs to whichever app needs one. -->
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <!-- Same reason as DarkTextBox: WPF's built-in Cut/Copy/Paste menu is built from the
                 framework theme and ignores this app's ContextMenu/MenuItem styles. -->
            <Setter Property="ContextMenu" Value="{DynamicResource TextInputContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin is a transparent halo so the drop shadow has room to render. -->
    <!-- Dialog cards sit on the dark tier. Inputs and DimTextBrush are calibrated against it;
         on SurfaceBrush a field is the same colour as the card behind it. -->
    <Border x:Name="RootBorder" Opacity="0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" CornerRadius="6"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource IconShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="The " Foreground="#D8000000"/><Run Text="Killendar" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="The " Foreground="{DynamicResource TextBrush}"/><Run Text="Killendar" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                        </Grid>
                        <Button Content="&#x2715;" Click="Cancel_Click"
                                HorizontalAlignment="Right"
                                Width="28" FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,20,24,16">
                    <TextBlock x:Name="HeadingText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <PasswordBox x:Name="PwBox" Style="{StaticResource DarkPasswordBox}"
                                 KeyDown="PwBox_KeyDown"/>
                    <TextBlock x:Name="ConfirmLabel" Text="{DynamicResource Str_Pw_ConfirmLbl}"
                               Foreground="{DynamicResource DimTextBrush}"
                               FontFamily="Consolas" FontSize="10"
                               Margin="0,8,0,2" Visibility="Collapsed"/>
                    <PasswordBox x:Name="PwConfirmBox" Style="{StaticResource DarkPasswordBox}"
                                 KeyDown="PwBox_KeyDown" Visibility="Collapsed"/>
                    <TextBlock x:Name="HintText" Text="{DynamicResource Str_Pw_NoRecovery}"
                               Foreground="{DynamicResource DimTextBrush}"
                               FontSize="11" LineHeight="16" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ExtraButton (left) is the unlock prompt's escape hatch: shown only when the
                     caller passes extraText ("New Killendar..."). -->
                <Grid Grid.Row="2" Margin="24,0,24,20">
                    <Button x:Name="ExtraButton" Click="Extra_Click" Visibility="Collapsed"
                            Style="{StaticResource SurfaceButton}" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}"
                                Click="Cancel_Click" Style="{StaticResource SurfaceButton}"
                                Width="80" Margin="0,0,8,0"/>
                        <Button x:Name="OkButton" Click="OK_Click"
                                Style="{StaticResource OutlineButton}" MinWidth="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
