<!-- Sentence box (Q): one line of text becomes a new appointment. A preview under the box shows
     how the line is read; Enter closes with Result set and the shell opens the edit panel. Same
     chrome as SearchDialog. -->
<Window x:Class="Killendar.Controls.QuickAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:icons="clr-namespace:Killendar.Controls"
        xmlns:kui="clr-namespace:Killendar.Controls"
        Title="Killendar"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!-- Card and caption are the shared DialogCard style and DialogTitleBar control
         (Controls.xaml, DialogTitleBar.xaml), never inline copies. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <kui:DialogTitleBar Grid.Row="0" CloseRequested="Close_Click"/>

                <StackPanel Grid.Row="1" Margin="12,8,12,12">
                    <TextBox x:Name="LineBox" Style="{StaticResource DarkTextBox}" FontSize="13" Padding="6,0"
                             AutomationProperties.Name="{DynamicResource Str_QA_Box}"
                             TextChanged="LineBox_TextChanged" PreviewKeyDown="LineBox_PreviewKeyDown"/>
                    <TextBlock Text="{DynamicResource Str_QA_Hint}" FontSize="10.5"
                               Foreground="{DynamicResource DimTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBlock x:Name="PreviewText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Grid>
    </ContentControl>
</Window>
