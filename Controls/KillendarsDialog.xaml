<!-- Manage Killendars: browse, create, rename, delete, import and switch between the .kcal
     files in the data folder. Same dialog chrome as ConfirmDialog and PasswordDialog. The
     caller closes the store before showing this, so every file - the active one included -
     is safe to touch. There is deliberately no data-folder picker: Killendars are per-user
     in APPDATA by design. -->
<Window x:Class="Killendar.Controls.KillendarsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Killendar"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- Dark tier, so the fields and list rows on top of it read as raised. -->
    <Border x:Name="RootBorder" Opacity="0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" CornerRadius="6"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0">
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource IconShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="The " Foreground="#D8000000"/><Run Text="Killendar" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="The " Foreground="{DynamicResource TextBrush}"/><Run Text="Killendar" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                        </Grid>
                        <Button Content="&#x2715;" Click="Close_Click"
                                HorizontalAlignment="Right"
                                Width="28" FontSize="10"
                                Foreground="{StaticResource MutedTextBrush}"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,16,24,12">
                    <TextBlock Text="{DynamicResource Str_Kc_Title}" Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas" FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource Str_Kc_Hint}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource PaneBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ListBox x:Name="KcList" Height="180" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" Margin="4"
                                 MouseDoubleClick="KcList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="KcList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Rename}" Click="RenameMenu_Click"/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Delete}" Click="Delete_Click"/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_CopyFile}" Click="CopyFileMenu_Click"
                                              ToolTip="{DynamicResource Str_TT_CopyFile}"/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Reveal}" Click="RevealMenu_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <TextBlock x:Name="DlgStatus" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Glyph buttons left (new / delete / load from a file / reveal in Explorer);
                     rename is inline via double-click. Open on the right.
                     Padding 0: SurfaceButton's side padding clips glyphs at a fixed width.
                     Glyph Content is set in code (Segoe MDL2 private-use characters must never be
                     pasted literally into XAML). -->
                <Grid Grid.Row="2" Margin="24,0,24,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="NewBtn" Click="New_Click" ToolTip="{DynamicResource Str_TT_NewKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="DeleteBtn" Click="Delete_Click" ToolTip="{DynamicResource Str_TT_DeleteKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="LoadBtn" Click="Load_Click" ToolTip="{DynamicResource Str_TT_LoadKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="ExplorerBtn" Click="Explorer_Click" ToolTip="{DynamicResource Str_TT_Explorer}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenBtn" Content="{DynamicResource Str_Btn_Open}" Click="Open_Click"
                                Style="{StaticResource OutlineButton}" Width="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
