<!-- Manage Killendars: browse, create, rename, delete, import and switch between the .kcal
     files in the data folder. Same dialog chrome as ConfirmDialog and PasswordDialog. The
     caller closes the store before showing this, so every file - the active one included -
     is safe to touch. There is deliberately no data-folder picker: Killendars are per-user
     in APPDATA by design. -->
<Window x:Class="Killendar.Controls.KillendarsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:KillerFamily.Accessibility"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:icons="clr-namespace:Killendar.Controls"
        xmlns:kui="clr-namespace:Killendar.Controls"
        Title="{DynamicResource Str_Kc_Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!-- Card and caption are the shared DialogCard style and DialogTitleBar control
         (Controls.xaml, DialogTitleBar.xaml), never inline copies. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <kui:DialogTitleBar Grid.Row="0" Subtitle="{DynamicResource Str_Kc_Title}" CloseRequested="Close_Click"/>

                <StackPanel Grid.Row="1" Margin="12,8,12,8">
                    <TextBlock Text="{DynamicResource Str_Kc_Hint}" Foreground="{DynamicResource TextBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <!-- The list is a pane: a childless shadow sibling behind it, the crossed sunken
                         bevel, and the grain overlay last, above the rows. -->
                    <Grid>
                    <Border IsHitTestVisible="False" Background="{DynamicResource PaneBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            Effect="{DynamicResource PaneShadowEffect}"/>
                    <Border Background="{DynamicResource PaneBrush}"
                            BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ListBox x:Name="KcList" Height="180" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" Margin="4"
                                 MouseDoubleClick="KcList_MouseDoubleClick"
                                 SelectionChanged="KcList_SelectionChanged"
                                 PreviewKeyDown="KcList_PreviewKeyDown"
                                 PreviewMouseRightButtonDown="KcList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="RowMenu_Opened" Style="{DynamicResource CardMenu}" MinWidth="324" MaxWidth="324">
                                    <MenuItem Header="{DynamicResource Str_Ctx_Open}" Click="Open_Click" InputGestureText="Enter">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="RenameMenu" Header="{DynamicResource Str_Ctx_Rename}" Click="RenameMenu_Click" InputGestureText="F2">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem x:Name="DeleteMenu" Header="{DynamicResource Str_Ctx_Delete}" Click="Delete_Click" InputGestureText="Delete">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Ctx_CopyFile}" Click="CopyFileMenu_Click"
                                              ToolTip="{DynamicResource Str_TT_CopyFile}">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Reveal}" Click="RevealMenu_Click">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE838;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <!-- Filled with the selected calendar's backups as the menu opens. -->
                                    <MenuItem x:Name="RestoreBackupMenu" Header="{DynamicResource Str_Ctx_RestoreBackup}">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Opacity="{DynamicResource GrainOpacity}"
                            Background="{DynamicResource GrainTileBrush}"/>
                    </Grid>
                    <TextBlock x:Name="DlgStatus" Foreground="{DynamicResource TextBrush}"
                               FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Glyph buttons left: new / delete / load, then one storage button whose labeled
                     flyout owns open-folder / choose-folder / portable-folder. Rename is inline
                     via double-click. Open on the right.
                     Padding 0: SurfaceButton's side padding clips glyphs at a fixed width.
                     Glyph Content is set in code (Segoe MDL2 private-use characters must never be
                     pasted literally into XAML). -->
                <Grid Grid.Row="2" Margin="12,0,12,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="NewBtn" Click="New_Click" ToolTip="{DynamicResource Str_TT_NewKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="DeleteBtn" Click="Delete_Click" ToolTip="{DynamicResource Str_TT_DeleteKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="LoadBtn" Click="Load_Click" ToolTip="{DynamicResource Str_TT_LoadKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="StorageBtn" Click="Storage_Click" ToolTip="{DynamicResource Str_TT_StorageOptions}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="StorageMenu" Placement="Top" Style="{DynamicResource CardMenu}" MinWidth="324" MaxWidth="324">
                                    <MenuItem Header="{DynamicResource Str_Menu_OpenDataFolder}" Click="Explorer_Click">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE838;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Menu_ChooseDataFolder}" Click="Folder_Click">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Menu_PortableDataFolder}" Click="PortableFolder_Click">
                                        <MenuItem.Icon><a11y:Glyph Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenBtn" Content="{DynamicResource Str_Btn_Open}" Click="Open_Click"
                                Style="{StaticResource OutlineButton}" Width="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
    </ContentControl>
</Window>
