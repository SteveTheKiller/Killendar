<!-- Manage Killendars: browse, create, rename, delete, import and switch between the .kcal
     files in the data folder. Same dialog chrome as ConfirmDialog and PasswordDialog. The
     caller closes the store before showing this, so every file - the active one included -
     is safe to touch. There is deliberately no data-folder picker: Killendars are per-user
     in APPDATA by design. -->
<Window x:Class="Killendar.Controls.KillendarsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Kc_Title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <!-- Dark tier, so the fields and list rows on top of it read as raised. -->
    <Border x:Name="RootBorder" Opacity="0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="{DynamicResource DialogShadowOpacity}"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}"
                        Height="{DynamicResource DialogTitleBarHeight}"
                        CornerRadius="{DynamicResource DialogTitleCornerRadius}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource DialogTitleCornerRadius}"
                                Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        <Grid Margin="{DynamicResource DialogTitleTextMargin}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{DynamicResource WordmarkVisibility}">
                            <TextBlock Text="{DynamicResource Str_Kc_Title}" Margin="1,2,0,0"
                                       FontFamily="{DynamicResource WordmarkFont}" FontSize="15" FontWeight="Bold"
                                       Foreground="#D8000000" Opacity="{DynamicResource IconShadowOpacity}">
                                <TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource Str_Kc_Title}"
                                       FontFamily="{DynamicResource WordmarkFont}" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str_Kc_Title}" Visibility="{DynamicResource PlainTitleVisibility}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Margin="{DynamicResource DialogTitleTextMargin}"
                                   FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource ChromeTextBrush}"/>
                        <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource ChromeCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="{DynamicResource DialogCaptionCloseMargin}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="24,14,24,12">
                    <TextBlock Text="{DynamicResource Str_Kc_Hint}" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid>
                    <Border IsHitTestVisible="False" Background="{DynamicResource PaneBrush}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"/>
                    <Border Background="{DynamicResource PaneBrush}"
                            BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                Background="{DynamicResource GrainTileBrush}" Opacity="{DynamicResource GrainOpacity}"/>
                        <ListBox x:Name="KcList" Height="180" Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch" Margin="4"
                                 MouseDoubleClick="KcList_MouseDoubleClick"
                                 PreviewKeyDown="KcList_PreviewKeyDown"
                                 PreviewMouseRightButtonDown="KcList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Open}" Click="Open_Click" InputGestureText="Enter">
                                        <MenuItem.Icon><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Rename}" Click="RenameMenu_Click" InputGestureText="F2">
                                        <MenuItem.Icon><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Delete}" Click="Delete_Click" InputGestureText="Delete">
                                        <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Ctx_CopyFile}" Click="CopyFileMenu_Click"
                                              ToolTip="{DynamicResource Str_TT_CopyFile}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Ctx_Reveal}" Click="RevealMenu_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        </Grid>
                    </Border>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                    <Border IsHitTestVisible="False" BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                    </Grid>
                    <TextBlock x:Name="DlgStatus" Foreground="{DynamicResource DimTextBrush}"
                               FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Glyph buttons left: new / delete / load, then one storage button whose labeled
                     flyout owns open-folder / choose-folder / portable-folder. Rename is inline
                     via double-click. Open on the right.
                     Padding 0: SurfaceButton's side padding clips glyphs at a fixed width.
                     Glyph Content is set in code (Segoe MDL2 private-use characters must never be
                     pasted literally into XAML). -->
                <Grid Grid.Row="2" Margin="24,0,24,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="NewBtn" Click="New_Click" ToolTip="{DynamicResource Str_TT_NewKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="DeleteBtn" Click="Delete_Click" ToolTip="{DynamicResource Str_TT_DeleteKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="LoadBtn" Click="Load_Click" ToolTip="{DynamicResource Str_TT_LoadKcal}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0" Margin="0,0,6,0"/>
                        <Button x:Name="StorageBtn" Click="Storage_Click" ToolTip="{DynamicResource Str_TT_StorageOptions}"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets"
                                Width="34" Padding="0">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="StorageMenu" Placement="Top">
                                    <MenuItem Header="{DynamicResource Str_Menu_OpenDataFolder}" Click="Explorer_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Menu_ChooseDataFolder}" Click="Folder_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{DynamicResource Str_Menu_PortableDataFolder}" Click="PortableFolder_Click">
                                        <MenuItem.Icon><TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenBtn" Content="{DynamicResource Str_Btn_Open}" Click="Open_Click"
                                Style="{StaticResource OutlineButton}" Width="80"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9000" IsHitTestVisible="False" BorderBrush="{DynamicResource OverlayBevelOuterDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerLightBrush}" BorderThickness="{DynamicResource OverlayBevelLightThickness}"/>
            <Border Panel.ZIndex="9001" IsHitTestVisible="False" Margin="{DynamicResource OverlayBevelInnerMargin}" BorderBrush="{DynamicResource OverlayBevelInnerDarkBrush}" BorderThickness="{DynamicResource OverlayBevelDarkThickness}"/>
        </Grid>
    </Border>
</Window>
