<!-- Reminders that have come due: topmost, in the corner of the screen, never stealing focus
     from what the user is typing. Same chrome as ConfirmDialog. Rows are built in code
     (RemindersWindow.xaml.cs). -->
<Window x:Class="Killendar.Controls.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:icons="clr-namespace:Killendar.Controls"
        xmlns:kui="clr-namespace:Killendar.Controls"
        Title="Killendar"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="Manual" Topmost="True" ShowActivated="False"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="True">

    <!-- Card and caption are the shared DialogCard style and DialogTitleBar control
         (Controls.xaml, DialogTitleBar.xaml), never inline copies. -->
    <ContentControl x:Name="RootBorder" Opacity="0" Style="{StaticResource DialogCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <kui:DialogTitleBar Grid.Row="0" CloseRequested="Close_Click"/>

                <StackPanel Grid.Row="1" Margin="12,8,12,8">
                    <TextBlock x:Name="HeadingText" Text="{DynamicResource Str_Rem_Head}"
                               theme:HeadingAccent.Enabled="True"
                               FontFamily="{DynamicResource HeadingFont}" FontSize="18"
                               TextOptions.TextFormattingMode="Ideal"/>
                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel x:Name="Rows"/>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="12,0,12,12">
                    <Button x:Name="OpenButton" Content="{DynamicResource Str_Rem_Open}" Click="Open_Click"
                            Style="{StaticResource SurfaceButton}"
                            Height="28" MinWidth="80" Padding="12,2" Margin="0,0,8,0"/>
                    <Button x:Name="DismissAllButton" Content="{DynamicResource Str_Rem_DismissAll}" Click="DismissAll_Click"
                            Style="{StaticResource OutlineButton}"
                            Height="28" MinWidth="80" Padding="12,2"/>
                </StackPanel>
            </Grid>
    </ContentControl>
</Window>
