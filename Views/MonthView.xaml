<UserControl x:Class="Killendar.Views.MonthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="MonthRoot" SizeChanged="MonthRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>   <!-- weekday header -->
            <RowDefinition Height="*"/>    <!-- day cells -->
        </Grid.RowDefinitions>

        <!-- The active month is painted as one stepped silhouette. Spillover dates have no
             cell fill at all: their numbers sit directly on the textured window background. -->
        <Path x:Name="MonthSilhouette" Grid.RowSpan="2"
              Fill="{DynamicResource PaneBrush}" IsHitTestVisible="False"
              SnapsToDevicePixels="True">
            <Path.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0"
                                  Opacity="{DynamicResource PaneShadowOpacity}"/>
            </Path.Effect>
        </Path>
        <Path x:Name="MonthSilhouetteGrain" Grid.RowSpan="2"
              Fill="{DynamicResource GrainTileBrush}"
              Opacity="{DynamicResource GrainOpacity}"
              IsHitTestVisible="False" SnapsToDevicePixels="True"/>

        <!-- Month's weekday names are an axis, not a second floating card. Keeping this row
             transparent lets the stepped month silhouette begin exactly where its real days do. -->
        <Border Grid.Row="0" Background="Transparent">
            <Grid x:Name="WeekdayHeader"/>
        </Border>

        <Grid x:Name="CalGrid" Grid.Row="1"/>
    </Grid>
</UserControl>
