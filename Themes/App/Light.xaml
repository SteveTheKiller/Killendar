<!-- Killendar's own theme values: keys only Killendar's views use, or Killendar's layout of a
     family key it reads directly. ThemeManager.AppTokens (Services/AppTheme.cs) merges the Light values
     over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Appointment chips without a category. -->
    <SolidColorBrush x:Key="ChipBrush" Color="#f7f7f7" po:Freeze="True"/>
</ResourceDictionary>
